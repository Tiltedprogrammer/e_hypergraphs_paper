\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (0, -1) {};
		\node [style=node] (1) at (0, 0) {};
		\node [style=none] (2) at (-1, 1) {};
		\node [style=none] (3) at (1, 1) {};
		\node [style=none] (4) at (3, -1) {};
		\node [style=node] (5) at (3, 0) {};
		\node [style=none] (6) at (2, 1) {};
		\node [style=none] (7) at (4, 1) {};
		\node [style=node] (8) at (-1, 3) {};
		\node [style=none] (9) at (1, 3) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [in=-90, out=15] (1) to (3.center);
		\draw [in=-90, out=165, looseness=0.75] (1) to (2.center);
		\draw (1) to (0.center);
		\draw [in=-90, out=15] (5) to (7.center);
		\draw [in=-90, out=165, looseness=0.75] (5) to (6.center);
