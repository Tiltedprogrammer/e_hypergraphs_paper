\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=vertex] (0) at (-1, -3) {};
		\node [style=vertex set] (1) at (-1, -5) {};
		\node [style=none] (2) at (-1, -1) {};
		\node [style=none] (3) at (-2.75, -1) {};
		\node [style=none] (4) at (-2, 0) {};
		\node [style=vertex set] (5) at (-2.75, -2) {};
		\node [style=none] (6) at (-4, 0.05) {};
		\node [style=none] (7) at (0, 0.05) {};
		\node [style=none] (8) at (-4, -5) {};
		\node [style=none] (9) at (0, -5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (0) to (1);
		\draw (0) to (2.center);
		\draw [bend right=45, looseness=1.25] (2.center) to (4.center);
		\draw [bend left=45] (3.center) to (4.center);
		\draw (3.center) to (5);
		\draw [style=fancy blue dash] (6.center) to (7.center);
		\draw [style=fancy blue dash] (8.center) to (9.center);
	\end{pgfonlayer}
\end{tikzpicture}
