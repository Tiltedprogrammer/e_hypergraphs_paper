\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-3.5, 0.5) {};
		\node [style=none] (1) at (-2.5, 1.5) {};
		\node [style=none] (2) at (-1.5, 0.5) {};
		\node [style=none] (3) at (-1.5, -1) {};
		\node [style=none] (4) at (-3.5, -1) {};
		\node [style=none] (5) at (0, 0) {$=$};
		\node [style=none] (6) at (1, 0.5) {};
		\node [style=none] (7) at (2, 1.5) {};
		\node [style=none] (8) at (3, 0.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [in=-180, out=90] (0.center) to (1.center);
		\draw [in=90, out=0] (1.center) to (2.center);
		\draw [in=90, out=-90, looseness=0.75] (2.center) to (4.center);
		\draw [in=90, out=-90, looseness=0.75] (0.center) to (3.center);
		\draw [in=-180, out=90] (6.center) to (7.center);
		\draw [in=90, out=0] (7.center) to (8.center);
	\end{pgfonlayer}
\end{tikzpicture}
