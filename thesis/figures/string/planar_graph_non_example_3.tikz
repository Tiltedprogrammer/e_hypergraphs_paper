\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=vertex] (0) at (-3.5, -3) {};
		\node [style=vertex set] (1) at (-3.5, -5) {};
		\node [style=vertex set] (2) at (-4.75, 0) {};
		\node [style=vertex set] (3) at (-2, 0) {};
		\node [style=none] (4) at (-3.5, -2) {};
		\node [style=none] (5) at (-6, 0) {};
		\node [style=none] (6) at (-0.75, 0) {};
		\node [style=none] (7) at (-6, -5) {};
		\node [style=none] (8) at (-0.75, -5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (1) to (0);
		\draw (4.center) to (0);
		\draw [in=-90, out=105] (4.center) to (2);
		\draw [in=-90, out=75] (4.center) to (3);
		\draw [style=fancy blue dash] (5.center) to (6.center);
		\draw [style=fancy blue dash] (7.center) to (8.center);
	\end{pgfonlayer}
