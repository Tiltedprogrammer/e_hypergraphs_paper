\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (1, 1) {};
		\node [style=none] (1) at (2, 0) {};
		\node [style=none] (2) at (3, 1) {};
		\node [style=node] (3) at (2, -1) {};
		\node [style=none] (4) at (0, 0) {$\defeq$};
		\node [style=none] (5) at (-3, 1) {};
		\node [style=none] (6) at (-2, 0) {};
		\node [style=none] (7) at (-1, 1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [in=180, out=-90] (0.center) to (1.center);
		\draw [in=-90, out=0] (1.center) to (2.center);
		\draw (3) to (1.center);
		\draw [in=180, out=-90] (5.center) to (6.center);
		\draw [in=-90, out=0] (6.center) to (7.center);
	\end{pgfonlayer}
