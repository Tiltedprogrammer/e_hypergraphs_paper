\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=vertex] (0) at (-2.5, -2.75) {};
		\node [style=vertex set] (1) at (-1.5, 0) {};
		\node [style=vertex set] (2) at (-3.5, 0) {};
		\node [style=none] (3) at (-2.5, -1.25) {};
		\node [style=none] (4) at (-1.5, -2) {};
		\node [style=none] (5) at (-3.5, -2) {};
		\node [style=vertex set] (6) at (-2.5, -5) {};
		\node [style=none] (7) at (-4, 0) {};
		\node [style=none] (8) at (-1, 0) {};
		\node [style=none] (9) at (-4, -5) {};
		\node [style=none] (10) at (-1, -5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend left=45, looseness=0.75] (1) to (3.center);
		\draw [bend left=45] (3.center) to (2);
		\draw [bend right=45] (3.center) to (5.center);
		\draw [bend left=45] (3.center) to (4.center);
		\draw [in=15, out=-90] (4.center) to (0);
		\draw [in=165, out=-90] (5.center) to (0);
		\draw (0) to (6);
		\draw [style=fancy blue dash] (7.center) to (8.center);
		\draw [style=fancy blue dash] (9.center) to (10.center);
	\end{pgfonlayer}
