\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=node] (0) at (0, 0) {};
		\node [style=none] (1) at (0, 2) {};
		\node [style=none] (2) at (-1.5, -2) {};
		\node [style=none] (3) at (1.5, -2) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (1.center) to (0);
		\draw [in=195, out=90] (2.center) to (0);
		\draw [in=90, out=-15] (0) to (3.center);
	\end{pgfonlayer}
\end{tikzpicture}
